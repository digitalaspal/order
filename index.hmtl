<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Transaksi Konter</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-purple: #7c4dff;
            --light-purple: #f3e8ff;
            --bg-gradient: linear-gradient(135deg, #f5f3ff 0%, #e0e7ff 100%);
            --card-shadow: 0 10px 25px -5px rgba(124, 77, 255, 0.1), 0 8px 10px -6px rgba(124, 77, 255, 0.1);
        }

        body {
            background: var(--bg-gradient);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            color: #334155;
        }

        .navbar-custom {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(124, 77, 255, 0.15);
        }

        .card-custom {
            background: #ffffff;
            border: none;
            border-radius: 16px;
            box-shadow: var(--card-shadow);
            transition: all 0.3s ease;
        }

        .btn-purple {
            background-color: var(--primary-purple);
            color: #ffffff;
            border: none;
            border-radius: 10px;
            padding: 10px 20px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .btn-purple:hover {
            background-color: #651fff;
            color: #ffffff;
            transform: translateY(-1px);
        }

        .form-control, .form-select {
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            padding: 10px 14px;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-purple);
            box-shadow: 0 0 0 3px rgba(124, 77, 255, 0.2);
        }

        .badge-pending {
            background-color: #fef3c7;
            color: #d97706;
        }

        .badge-success {
            background-color: #dcfce7;
            color: #15803d;
        }

        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.82rem;
            font-weight: 600;
        }

        .nav-pills .nav-link.active {
            background-color: var(--primary-purple);
            border-radius: 10px;
        }

        .nav-pills .nav-link {
            color: var(--primary-purple);
            font-weight: 600;
            border-radius: 10px;
        }

        .table-custom {
            border-radius: 12px;
            overflow: hidden;
        }

        .loader-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(4px);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>

    <!-- Overlay Loader -->
    <div id="loader" class="loader-overlay">
        <div class="text-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
            <p class="mt-3 fw-bold text-dark">Memproses request...</p>
        </div>
    </div>

    <!-- Header / Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#" style="color: var(--primary-purple);">
                <i class="fa-solid fa-bolt me-2"></i>Konter Digital
            </a>
            <div class="d-flex align-items-center">
                <input type="password" id="pinAdmin" class="form-control form-control-sm me-2" style="width: 110px;" placeholder="PIN Admin">
                <button class="btn btn-purple btn-sm" onclick="loadPembeli()"><i class="fa-solid fa-sync"></i> Refresh</button>
            </div>
        </div>
    </nav>

    <div class="container my-4">
        <!-- Tab Navigasi -->
        <ul class="nav nav-pills mb-4 justify-content-center bg-white p-2 rounded-3 shadow-sm" id="pills-tab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="pills-order-tab" data-bs-toggle="pill" data-bs-target="#pills-order" type="button"><i class="fa-solid fa-cart-shopping me-1"></i> Order Web</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-manual-tab" data-bs-toggle="pill" data-bs-target="#pills-manual" type="button"><i class="fa-solid fa-keyboard me-1"></i> TRX Manual</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-data-tab" data-bs-toggle="pill" data-bs-target="#pills-data" type="button" onclick="loadPembeli()"><i class="fa-solid fa-list me-1"></i> Laporan TRX</button>
            </li>
        </ul>

        <div class="tab-content" id="pills-tabContent">
            
            <!-- TAB 1: FORM ORDERAN WEB -->
            <div class="tab-pane fade show active" id="pills-order">
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <div class="card card-custom p-4">
                            <h5 class="fw-bold mb-3 text-center" style="color: var(--primary-purple);"><i class="fa-solid fa-mobile-screen me-2"></i>Beli Paket Data</h5>
                            <form id="formWebOrder">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Nomor HP / WA</label>
                                    <input type="number" id="webNomor" class="form-control" placeholder="08xxxxxxxxxx" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Pilih Paket Data</label>
                                    <select id="webPaket" class="form-select" required>
                                        <option value="">-- Pilih Paket --</option>
                                        <option value="Telkomsel 5GB 30 Hari">Telkomsel 5GB 30 Hari</option>
                                        <option value="Indosat 10GB 30 Hari">Indosat 10GB 30 Hari</option>
                                        <option value="XL Extra Combo 15GB">XL Extra Combo 15GB</option>
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-purple w-100 mt-2"><i class="fa-solid fa-paper-plane me-1"></i> Kirim Pesanan</button>
                            </form>
                            
                            <!-- Status Order Cek ID -->
                            <div id="orderStatusBox" class="mt-4 p-3 bg-light rounded-3 d-none text-center">
                                <p class="mb-1 text-muted small">ID Transaksi Anda:</p>
                                <h4 class="fw-bold text-dark" id="displayID">-</h4>
                                <p class="mb-2">Status: <span id="displayStatus" class="status-badge badge-pending">PENDING</span></p>
                                <button class="btn btn-sm btn-outline-secondary" onclick="cekStatusOrder()"><i class="fa-solid fa-arrows-rotate me-1"></i> Cek Status Terkini</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 2: CATAT TRX MANUAL KONTER -->
            <div class="tab-pane fade" id="pills-manual">
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <div class="card card-custom p-4">
                            <h5 class="fw-bold mb-3 text-center" style="color: var(--primary-purple);"><i class="fa-solid fa-cash-register me-2"></i>Catat Transaksi Manual</h5>
                            <form id="formManualTrx">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Nomor WA Pengisi</label>
                                    <input type="number" id="manualNomorWA" class="form-control" placeholder="085796695681">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Nomor Pelanggan (Target)</label>
                                    <input type="number" id="manualNomorPelanggan" class="form-control" placeholder="08xxxxxxxxxx" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Nama Pelanggan</label>
                                    <input type="text" id="manualNama" class="form-control" placeholder="HPMM / Nama Pelanggan">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Jenis Paket / Produk</label>
                                    <input type="text" id="manualPaket" class="form-control" placeholder="Contoh: Pulsa 50k / Telkomsel 10GB" required>
                                </div>
                                <button type="submit" class="btn btn-purple w-100 mt-2"><i class="fa-solid fa-floppy-disk me-1"></i> Simpan Transaksi</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 3: LAPORAN TRANSAKSI -->
            <div class="tab-pane fade" id="pills-data">
                <div class="card card-custom p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold m-0" style="color: var(--primary-purple);"><i class="fa-solid fa-clock-rotate-left me-2"></i>Riwayat Transaksi</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-custom">
                            <thead class="table-light">
                                <tr>
                                    <th>Tanggal & No</th>
                                    <th>Nomor WA</th>
                                    <th>Nama</th>
                                    <th>Produk</th>
                                    <th>Status</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="tableBodyPembeli">
                                <tr>
                                    <td colspan="6" class="text-center text-muted">Klik refresh untuk memuat data.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Script JS & Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // GANTI URL INI DENGAN WEB APP URL DARI GOOGLE APPS SCRIPT ANDA
        const SCRIPT_URL = "https://orderan.digitalaspal.workers.dev/"; 

        let lastCreatedID = "";

        function toggleLoader(show) {
            document.getElementById('loader').style.display = show ? 'flex' : 'none';
        }

        // 1. Submit Form Order Web
        document.getElementById('formWebOrder').addEventListener('submit', function(e) {
            e.preventDefault();
            toggleLoader(true);

            const nomor = document.getElementById('webNomor').value;
            const paket = document.getElementById('webPaket').value;

            fetch(`${SCRIPT_URL}?action=create&nomor=${encodeURIComponent(nomor)}&paket=${encodeURIComponent(paket)}`)
            .then(res => res.json())
            .then(data => {
                toggleLoader(false);
                if(data.result === 'success') {
                    lastCreatedID = data.id;
                    document.getElementById('displayID').innerText = data.id;
                    document.getElementById('displayStatus').innerText = "PENDING";
                    document.getElementById('displayStatus').className = "status-badge badge-pending";
                    document.getElementById('orderStatusBox').classList.remove('d-none');
                    alert("Pesanan berhasil dibuat! Silahkan konfirmasi via admin/Telegram.");
                }
            })
            .catch(err => {
                toggleLoader(false);
                alert("Gagal mengirim pesanan: " + err);
            });
        });

        // 2. Cek Status Order Web
        function cekStatusOrder() {
            if(!lastCreatedID) return;
            toggleLoader(true);

            fetch(`${SCRIPT_URL}?action=check&id=${encodeURIComponent(lastCreatedID)}`)
            .then(res => res.json())
            .then(data => {
                toggleLoader(false);
                const badge = document.getElementById('displayStatus');
                badge.innerText = data.status;
                if(data.status === "SUCCESS") {
                    badge.className = "status-badge badge-success";
                } else {
                    badge.className = "status-badge badge-pending";
                }
            })
            .catch(err => {
                toggleLoader(false);
                alert("Gagal mengecek status: " + err);
            });
        }

        // 3. Submit Transaksi Manual Konter
        document.getElementById('formManualTrx').addEventListener('submit', function(e) {
            e.preventDefault();
            toggleLoader(true);

            const payload = {
                action: "catat_trx_konter",
                nomorWA: document.getElementById('manualNomorWA').value,
                nomorPelanggan: document.getElementById('manualNomorPelanggan').value,
                nama: document.getElementById('manualNama').value,
                jenisPaket: document.getElementById('manualPaket').value
            };

            fetch(SCRIPT_URL, {
                method: "POST",
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                toggleLoader(false);
                if(data.status === 'success') {
                    alert(data.message);
                    document.getElementById('formManualTrx').reset();
                } else {
                    alert("Error: " + data.message);
                }
            })
            .catch(err => {
                toggleLoader(false);
                alert("Gagal menyimpan transaksi: " + err);
            });
        });

        // 4. Load Data Pembeli ke Tabel
        function loadPembeli() {
            toggleLoader(true);
            const pin = document.getElementById('pinAdmin').value;

            fetch(`${SCRIPT_URL}?action=getPembeli&start=0&limit=20&pin=${encodeURIComponent(pin)}`)
            .then(res => res.json())
            .then(data => {
                toggleLoader(false);
                const tbody = document.getElementById('tableBodyPembeli');
                tbody.innerHTML = "";

                if(!data.pembeli || data.pembeli.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted">Belum ada data transaksi.</td></tr>`;
                    return;
                }

                data.pembeli.forEach(item => {
                    const isSuccess = (item.status || "").toLowerCase() === 'selesai' || (item.status || "").toLowerCase() === 'success';
                    const badgeClass = isSuccess ? 'badge-success' : 'badge-pending';
                    const noWA = item.r ? item.r : `****${item.digit}`;

                    const row = `
                        <tr>
                            <td class="fw-semibold">${item.q || '-'}</td>
                            <td>${noWA}</td>
                            <td>${item.t || '-'}</td>
                            <td>${item.v || '-'}</td>
                            <td><span class="status-badge ${badgeClass}">${item.status || 'Pending'}</span></td>
                            <td>
                                ${!isSuccess ? `<button class="btn btn-sm btn-success" onclick="updateStatusSelesai('${noWA}', '${item.q}')"><i class="fa-solid fa-check"></i></button>` : '<i class="fa-solid fa-check-double text-success"></i>'}
                            </td>
                        </tr>
                    `;
                    tbody.innerHTML += row;
                });
            })
            .catch(err => {
                toggleLoader(false);
                alert("Gagal memuat data: " + err);
            });
        }

        // 5. Update Status Manual ke Selesai
        function updateStatusSelesai(nomor, waktu) {
            if(!confirm("Tandai transaksi ini sebagai Selesai?")) return;
            toggleLoader(true);

            fetch(`${SCRIPT_URL}?action=updateStatus&nomor=${encodeURIComponent(nomor)}&waktu=${encodeURIComponent(waktu)}&status=Selesai`)
            .then(res => res.json())
            .then(data => {
                toggleLoader(false);
                if(data.result === 'success') {
                    loadPembeli();
                } else {
                    alert("Gagal mengubah status!");
                }
            })
            .catch(err => {
                toggleLoader(false);
                alert("Error: " + err);
            });
        }
    </script>
</body>
</html>
